mpleted'\n        return self.get_state().particles[particle_id]\n\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self._particles[particle_id]\n        if p['status'] == 'pruned':\n            raise InvalidActionError('pruned')\n        self._charge(1)\n        aid = self._next_aid\n        self._next_aid += 1\n        t = p['time']\n        base = 0.45 + 0.45 * t\n        noise = ((particle_id * 17 + aid * 7) % 9) * 0.01\n        score = min(0.99, base + noise)\n        uncertainty = max(0.0, 1.0 - t)\n        drift = max(0.0, 0.2 - 0.15 * t + ((aid + particle_id) % 3) * 0.01)\n        rec = PreviewRecord(id=aid, particle_id=particle_id, time=t, score=score, score_dict={'fake': score}, uncertainty=uncertainty, drift=drift, embedding_ref=None)\n        self._previews[aid] = rec\n        p['last_preview_id'] = aid\n        return rec\n\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        ids = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self._particles[pid] = {'time': max([t for t in self.time_grid if t <= target_time]), 'status': 'active', 'last_preview_id': None, 'source_anchor_id': anchor_id}\n            ids.append(pid)\n        return ids\n\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            if self._particles[pid]['status'] == 'completed':\n                raise InvalidActionError('completed')\n            self._particles[pid]['status'] = 'pruned'\n\n    def answer(self, rule='best_preview_score'):\n        if rule == 'best_preview_score' and self._previews:\n            best = max(self._previews.values(), key=lambda p: p.score)\n            return AnswerRecord(particle_id=best.particle_id, preview_id=best.id, latent=(), reward=best.score, nfe_used=self.budget-self._budget_left, rule=rule, event_log=[], score_dict=best.score_dict)\n        active = [pid for pid,p in self._particles.items() if p['status'] in {'active','completed'}]\n        return AnswerRecord(particle_id=active[-1] if active else None, preview_id=None, latent=(), reward=None, nfe_used=self.budget-self._budget_left, rule=rule, event_log=[], score_dict={})\n\n    def get_state(self):\n        particles = {}\n        for pid,p in self._particles.items():\n            particles[pid] = ParticleSummary(id=pid, time=p['time'], parent_id=None, source_anchor_id=p['source_anchor_id'], nfe_used=0, status=p['status'], last_preview_id=p['last_preview_id'], num_children=0)\n        return ControllerState(prompt='fake', budget_left=self._budget_left, active_particle_ids=[pid for pid,p in self._particles.items() if p['status']=='active'], completed_particle_ids=[pid for pid,p in self._particles.items() if p['status']=='completed'], pruned_particle_ids=[pid for pid,p in self._particles.items() if p['status']=='pruned'], particles=particles, previews=dict(self._previews), event_log=[])\n\ncontroller = OptimalController()\nfor beta in [0.0,0.25,0.5,0.75,1.0]:\n    env = FakeEnv()\n    ans = controller.solve(env, beta)\n    print(beta, ans.nfe_used, ans.reward)\nPY\"","aggregated_output":"0.0 10 0.8800000000000001\n0.25 18 0.9500000000000001\n0.5 24 0.915\n0.75 26 0.97\n1.0 41 0.97\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_42","type":"agent_message","text":"Implemented a new `OptimalController.solve()` in [flow_autotts/controllers/optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo_ocr/flow_autotts/controllers/optimal.py).\n\n**Controller Idea**\nThe policy is a single-root, preview-first controller with a new probe-before-commit refinement loop. It builds a root preview ladder, then uses `backward` children as cheap local probes: each child gets an immediate preview at the backward target time, and only children that are competitive on score or reduce uncertainty/drift earn the expensive promotion to `t=0.9/1.0` plus a late confirmation preview. Tail budget is then spent on ambiguity-driven confirmation or one more local probe, rather than blindly finishing more branches.\n\n**What I inspected**\nI read:\n- `flow_tts_controller_implementation_spec.md`\n- the injected context pack at `.../r0002.../context_pack.md`\n- current [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo_ocr/flow_autotts/controllers/optimal.py) and [baselines.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo_ocr/flow_autotts/controllers/baselines.py)\n- [state.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo_ocr/flow_autotts/core/state.py), [errors.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo_ocr/flow_autotts/core/errors.py), [env.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo_ocr/flow_autotts/experiments/ocr_sd35/env.py)\n- snapshot controllers from `r0000` and rejected `r0001`, plus `r0001` summary\n\nFrom the compact history:\n- `beta=0.0`: latest `reward=0.358123`, `mean_nfe=7`; above baseline.\n- `beta=0.25`: latest `reward=0.591981`, `mean_nfe=22`; above baseline.\n- `beta=0.5`: latest `reward=0.701755`, `mean_nfe=35`; slightly below baseline `0.706879`.\n- `beta=0.75`: latest `reward=0.776531`, `mean_nfe=47`; above baseline.\n- `beta=1.0`: latest `reward=0.807150`, `mean_nfe=61`; below baseline `0.818322`.\n\nThe last two snapshots were a real behavioral change, not cosmetic:\n- `r0000` used preview-guided refinement with one root and substantial late preview/backward spend.\n- rejected `r0001` shifted toward more roots but less evidence/continuation, and lost mostly from underuse.\n\n**Beta Schedule**\nThe schedule is explicit in `_schedule(beta)` and monotonic in willingness to spend:\n- `beta=0.0`: target `10`; root probes `(0.6, 0.8)`; no backward children.\n- `beta=0.25`: target `20`; root probes `(0.5, 0.8, 0.9)`; `2` child probes, `1` child commit.\n- `beta=0.5`: target `36`; root probes `(0.5, 0.7, 0.9)`; `4` child probes, `2` child commits.\n- `beta=0.75`: target `48`; root probes `(0.4, 0.6, 0.8, 0.9)`; `6` child probes, `3` child commits, `mixed_noise`.\n- `beta=1.0`: target `64`; same root ladder, but `8` child probes, `4` child commits, wider anchor pool, more tail rounds.\n\nMonotonicity comes from increasing or loosening:\n- probe count,\n- child probe budget,\n- child commit budget,\n- anchor pool,\n- tail rounds,\n- later promotion time,\n- gentler exploration noise at high beta.\n\n`beta=1.0` cannot exceed `64` because every costly `forward`/`preview` path is guarded by `_can_afford(..., target_nfe=64, ...)`, `target_nfe=min(env.budget, 64)`, and final termination uses `answer(rule=\"best_preview_score\")`, which has no implicit completion cost.\n\n**What’s New**\nBehaviorally new relative to the incumbent:\n- backward children are previewed immediately at the backward target time before earning finish budget;\n- promotion is adaptive from score gap and uncertainty/drift improvement, not just “spawn child then finish it”;\n- anchors are reused more evenly via `anchor_uses`, which preserves diversity at high beta without opening many roots;\n- tail spend is ambiguity-driven confirmation or one more selective local probe, aimed specifically at the weak `beta=0.5` and `beta=1.0` regimes.\n\n**Checks**\nRan:\n- `python -m py_compile flow_autotts/controllers/optimal.py`\n- a toy public `FlowTTSEnv` dry-run across `beta in {0, 0.25, 0.5, 0.75, 1.0}`\n- a small SD35-like fake env dry-run to confirm termination and budget guards under step-based charging\n\nI did not run the full SD3.5 OCR evaluation.\n\n**Target-NFE Reflection**\nInjected references:\n- `beta=0.0 -> 10`\n- `beta=0.25 -> 20`\n- `beta=0.5 -> 36`\n- `beta=0.75 -> 48`\n- `beta=1.0 -> 64`\n\nPer beta:\n- `0.0`: underuse in old controller looked unnecessary relative to the locked `10`. I adjusted it upward with a two-preview root ladder and no branching; intended to stay near `10` without wasting compute on refinement.\n- `0.25`: old controller was already above baseline and near target. I kept compute modest; any residual underuse is more likely justified than harmful. The child-probe budget is capped tightly to avoid low-beta waste.\n- `0.5`: this is the main repair target. Old run trailed baseline at `35 vs 36` NFE. I increased evidence-gathering and selective refinement so this regime can use more of the target budget through child probes, promotion, and tail confirmation.\n- `0.75`: old run already beat baseline near target. I changed allocation, not just volume: more selective child screening and gentler high-beta pruning should preserve the strong result while keeping spend comparable.\n- `1.0`: old run trailed baseline and underused at `61 vs 64`. I explicitly added more child probes, more commits, larger anchor pool, and longer tail confirmation to improve utilization when evidence remains ambiguous, while all costly actions remain capped below the hard `64`.\n\nMain risk: because this controller stays single-root, if SD3.5 OCR needs fresh global diversity rather than local refinement at high beta, `beta=1.0` could still underuse or miss some wins. The proposal is meant primarily to improve `beta=0.5` and `beta=1.0` without regressing the already-strong `0.25` and `0.75` rows."}}
