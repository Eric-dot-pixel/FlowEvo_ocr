{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass, field\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\nfrom flow_autotts.core.state import AnswerRecord, ControllerState, EventRecord, ParticleSummary, PreviewRecord\n\n@dataclass\nclass Particle:\n    id:int\n    time:float=0.0\n    status:str='active'\n    last_preview_id:int|None=None\n\nclass FakeEnv:\n    def __init__(self, budget=64, steps=10):\n        self.budget = budget\n        self._used = 0\n        self.time_grid = tuple(i/steps for i in range(steps+1))\n        self._next_pid = 0\n        self._next_aid = 0\n        self.particles = {}\n        self.previews = {}\n        self.events = []\n    @property\n    def budget_left(self):\n        return self.budget - self._used\n    def spawn(self, n):\n        if n <= 0:\n            raise InvalidActionError('bad spawn')\n        ids=[]\n        for _ in range(n):\n            pid=self._next_pid; self._next_pid += 1\n            self.particles[pid]=Particle(pid)\n            ids.append(pid)\n        return ids\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p=self.particles[particle_id]\n        if p.status \"'!= '\"'active':\n            raise InvalidActionError('inactive')\n        tgt=min(i for i,t in enumerate(self.time_grid) if t + 1e-9 >= target_time)\n        cur=min(i for i,t in enumerate(self.time_grid) if t + 1e-9 >= p.time)\n        cost=tgt-cur\n        if cost <= 0:\n            raise InvalidActionError('non-advancing')\n        if self._used + cost > self.budget:\n            raise BudgetExceededError\n        self._used += cost\n        p.time = self.time_grid[tgt]\n        if p.time >= 1.0:\n            p.status = 'completed'\n        return self.get_state().particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        if self._used + 1 > self.budget:\n            raise BudgetExceededError\n        p=self.particles[particle_id]\n        if p.status == 'pruned':\n            raise InvalidActionError('pruned')\n        self._used += 1\n        aid=self._next_aid; self._next_aid += 1\n        score = 0.2 * particle_id + 0.7 * p.time\n        unc = max(0.0, 1.0 - p.time)\n        pr=PreviewRecord(id=aid, particle_id=particle_id, time=p.time, score=score, uncertainty=unc, drift=0.1)\n        self.previews[aid]=pr\n        p.last_preview_id=aid\n        return pr\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if mask is not None:\n            raise InvalidActionError('mask unsupported')\n        parent_pid=self.previews[anchor_id].particle_id\n        ids=[]\n        for _ in range(num_children):\n            pid=self._next_pid; self._next_pid += 1\n            self.particles[pid]=Particle(pid, time=target_time, status='active')\n            ids.append(pid)\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            if self.particles[pid].status == 'completed':\n                raise InvalidActionError('cannot prune completed')\n            self.particles[pid].status = 'pruned'\n    def answer(self, rule='best_preview_score'):\n        if rule == 'best_preview_score' and self.previews:\n            best=max(self.previews.values(), key=lambda p:p.score)\n            return AnswerRecord(particle_id=best.particle_id, preview_id=best.id, latent=(), reward=best.score, nfe_used=self._used, rule=rule, event_log=[], score_dict={})\n        live=[p for p in self.particles.values() if p.status in ('active','completed')]\n        pid=max(live, key=lambda p:(p.time,p.id)).id if live else None\n        return AnswerRecord(particle_id=pid, preview_id=self.particles[pid].last_preview_id if pid is not None else None, latent=(), reward=0.0, nfe_used=self._used, rule=rule, event_log=[], score_dict={})\n    def get_state(self):\n        return ControllerState(prompt='x', budget_left=self.budget_left, active_particle_ids=[pid for pid,p in self.particles.items() if p.status=='active'], completed_particle_ids=[pid for pid,p in self.particles.items() if p.status=='completed'], pruned_particle_ids=[pid for pid,p in self.particles.items() if p.status=='pruned'], particles={pid: ParticleSummary(id=pid, time=p.time, parent_id=None, source_anchor_id=None, nfe_used=0, status=p.status, last_preview_id=p.last_preview_id, num_children=0) for pid,p in self.particles.items()}, previews=dict(self.previews), event_log=[])\n\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv()\n    ans = OptimalController().solve(env, beta)\n    print(beta, ans.nfe_used, ans.rule, ans.reward)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
