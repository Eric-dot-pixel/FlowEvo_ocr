ost\n        p.time=self.time_grid[step1]\n        p.nfe_used+=cost\n        if step1==len(self.time_grid)-1: p.status='completed'\n        return self.get_state().particles[particle_id]\n    def preview(self,particle_id,mode='clean_anchor',scorer='default'):\n        p=self._particles[particle_id]\n        if p.status=='pruned': raise InvalidActionError('pruned')\n        if self._nfe+1>self.budget: raise BudgetExceededError\n        self._nfe+=1\n        aid=self._next_aid; self._next_aid+=1\n        score=0.1 + 0.8*p.time + (particle_id % 3)*0.01 - p.num_children*0.005\n        uncertainty=max(0.0, 0.6 - 0.5*p.time)\n        prev=PreviewRecord(id=aid, particle_id=particle_id, time=p.time, score=score, uncertainty=uncertainty, score_dict={})\n        self._previews[aid]=prev\n        p.last_preview_id=aid\n        p.nfe_used+=1\n        return prev\n    def backward(self,anchor_id,target_time,noise_policy='fresh_noise',num_children=1,mask=None,strength=1.0):\n        if num_children<=0: raise InvalidActionError('bad child count')\n        if mask is not None: raise InvalidActionError('mask unsupported')\n        anchor=self._previews[anchor_id]\n        parent=self._particles[anchor.particle_id]\n        ids=[]\n        for _ in range(num_children):\n            pid=self._next_pid; self._next_pid+=1\n            self._particles[pid]=Particle(id=pid,time=target_time,parent_id=parent.id,source_anchor_id=anchor_id)\n            ids.append(pid)\n        parent.num_children += num_children\n        return ids\n    def prune(self,particle_ids):\n        for pid in particle_ids:\n            p=self._particles[pid]\n            if p.status=='completed': raise InvalidActionError('cannot prune completed')\n            p.status='pruned'\n    def answer(self,rule='best_preview_score'):\n        self._answered=True\n        if rule=='best_preview_score' and self._previews:\n            best=max(self._previews.values(), key=lambda x:x.score)\n            return AnswerRecord(particle_id=best.particle_id, preview_id=best.id, latent=(), reward=best.score, nfe_used=self._nfe, rule=rule, event_log=[], score_dict={})\n        active=[p for p in self._particles.values() if p.status in {'active','completed'}]\n        if not active:\n            return AnswerRecord(particle_id=None, preview_id=None, latent=(), reward=None, nfe_used=self._nfe, rule=rule, event_log=[], score_dict={})\n        chosen=max(active, key=lambda p:(p.time,p.id))\n        if chosen.status=='active':\n            self.forward(chosen.id,1.0,'euler')\n        return AnswerRecord(particle_id=chosen.id, preview_id=chosen.last_preview_id, latent=(), reward=chosen.time, nfe_used=self._nfe, rule=rule, event_log=[], score_dict={})\n    def get_state(self):\n        return ControllerState(prompt='x', budget_left=self.budget_left, active_particle_ids=[p.id for p in self._particles.values() if p.status=='active'], completed_particle_ids=[p.id for p in self._particles.values() if p.status=='completed'], pruned_particle_ids=[p.id for p in self._particles.values() if p.status=='pruned'], particles={pid: ParticleSummary(id=p.id,time=p.time,parent_id=p.parent_id,source_anchor_id=p.source_anchor_id,nfe_used=p.nfe_used,status=p.status,last_preview_id=p.last_preview_id,num_children=p.num_children) for pid,p in self._particles.items()}, previews=dict(self._previews), event_log=[])\n\ncontroller=OptimalController()\nfor beta in [0.0,0.25,0.5,0.75,1.0]:\n    env=FakeEnv()\n    ans=controller.solve(env,beta)\n    print(beta, ans.nfe_used, ans.rule, ans.reward)\nPY\"","aggregated_output":"0.0 10 best_preview_score 0.7400000000000001\n0.25 19 best_preview_score 0.7600000000000001\n0.5 36 best_preview_score 0.8400000000000001\n0.75 48 best_preview_score 0.8400000000000001\n1.0 64 best_preview_score 0.8400000000000001\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_28","type":"agent_message","text":"Implemented a new controller in [optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo_ocr/flow_autotts/controllers/optimal.py). The idea is a beta-conditioned, preview-first controller that spends compute in three stages: bounded scout width, staged contender advancement, and probe-before-commit backward refinement. The new mechanism is that backward children are no longer blindly finished to `t=1`; they are first advanced only to a late preview, then only the strongest active branch is promoted to full completion. The tail budget also reacts to score gaps: if the top two previews are close, it spends on the runner-up or a local rebranch instead of tunneling on the current leader.\n\nI inspected the compact baseline/target rows from the context pack, the latest frontier in `r0003`, the incumbent `r0000`, the rejected `r0001`/`r0002` lessons, and the controller snapshots for `r0000` and `r0003`. Latest `r0003` frontier was:\n- `beta=0.0`: reward `0.480700`, mean NFE `10.0`\n- `beta=0.25`: reward `0.552740`, mean NFE `19.0`\n- `beta=0.5`: reward `0.702412`, mean NFE `35.546`\n- `beta=0.75`: reward `0.768340`, mean NFE `48.0`\n- `beta=1.0`: reward `0.808591`, mean NFE `63.398`\n\nRelative to the beta-matched ODE baseline, `r0003` already beat baseline at `beta=0, 0.25, 0.75`, and still trailed slightly at `beta=0.5` and `beta=1.0`. The last two accepted snapshots were not cosmetic: `r0003` already changed behavior versus `r0000` by using target-NFE discipline, more preview, and gentler pruning. My change is another structural step, because it changes where refinement budget goes: late probes first, full finishes later.\n\nThe exact beta schedule is piecewise and monotone:\n- Target NFE is piecewise-linear through `(0.0,10)`, `(0.25,20)`, `(0.5,36)`, `(0.75,48)`, `(1.0,64)`, capped by `env.budget`.\n- `root_count = 1 + I[beta>=0.5] + I[beta>=0.75] + I[beta>=0.95]`\n- `scout_step = min(S-2, 3 + I[beta>=0.5])`\n- `mid_step = scout_step + 3`, `late_step = mid_step + 2`, both capped by the grid\n- `survivor_count = 1 + I[beta>=0.75]`\n- `max_child_probes = 1 + I[beta>=0.25] + I[beta>=0.5] + I[beta>=0.75] + I[beta>=0.95]`\n- `finish_budget = 1 + I[beta>=0.75]`\n- `tail_rounds = 1 + I[beta>=0.5] + I[beta>=0.75] + I[beta>=0.95]`\n- `mixed_noise` is used only for `beta>=0.75`\n- a single SDE scout is used only at `beta>=0.95`, and only on the last root\n\nBudget use is monotone because higher beta never lowers the target NFE, root count, child-probe budget, finish budget, or tail rounds. `beta=1.0` cannot exceed `64` because `target_nfe` is capped at `64`, every action is guarded by `_can_afford(...)`, and termination uses `answer(rule=\"best_preview_score\")` rather than `latest_active`, so there is no implicit final rollout overshoot.\n\nPer beta, the target-NFE reflection is:\n- `beta=0.0`, target `10`: prior underuse was already repaired in `r0003`; I kept a locked single-root, two-preview ladder designed to land exactly at `10`. Underuse is not justified here and was not left unresolved.\n- `beta=0.25`, target `20`: `r0003` was at `19`, which looked mildly conservative after the stronger `r0000` result at similar cost. I adjusted this regime to allow one finish plus up to two child probes and one tail action, so it should stay near `20` without wasting budget on broad width.\n- `beta=0.5`, target `36`: this was one of the main weak spots and the `35.546` underuse looked unjustified. I increased willingness to spend with `2` roots, `3` child probes, one finish promotion, and one tail action, specifically to repair allocation near this budget.\n- `beta=0.75`, target `48`: this regime was already above baseline at exactly target NFE, so I mostly protected it. It gets more diversity than low beta, but pruning remains conservative enough to avoid collapsing too early.\n- `beta=1.0`, target `64`: this was the primary weakness and the `63.398` underuse looked unjustified. I increased width to `4` roots, allow `5` child probes, `2` finish promotions, and `4` tail rounds, with one bounded SDE scout to add diversity without letting stochasticity dominate.\n\nChecks run:\n- `python -m py_compile flow_autotts/controllers/optimal.py`\n- a tiny fake-env dry run for `beta in {0.0, 0.25, 0.5, 0.75, 1.0}`; it produced NFE usage `10, 19, 36, 48, 64`, which is the intended schedule shape and verified the contract paths\n\nExpected risks are that extra width at `beta=0.5` and `beta=1.0` could be hurt by noisy early previews, and that late probe-first refinement may trade a little peak reward at `beta=0.75` if the old immediate-finish path was already ideal there. The proposal is mainly meant to improve `beta=0.5` and `beta=1.0`, while keeping `beta=0.0` and `beta=0.75` stable and keeping `beta=0.25` close to its strong prior tradeoff."}}
