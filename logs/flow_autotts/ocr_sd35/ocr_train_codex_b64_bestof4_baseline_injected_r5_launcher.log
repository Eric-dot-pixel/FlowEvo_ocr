{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.state import ParticleSummary, PreviewRecord, ControllerState, AnswerRecord, EventRecord\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\n\nclass FakeEnv:\n    def __init__(self, budget=64):\n        self.time_grid = tuple(i/10 for i in range(11))\n        self.budget = budget\n        self._nfe = 0\n        self._next_pid = 0\n        self._next_aid = 0\n        self.particles = {}\n        self.previews = {}\n    @property\n    def budget_left(self):\n        return self.budget - self._nfe\n    def spawn(self, n):\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self.particles[pid] = ParticleSummary(pid, 0.0, None, None, 0, 'active', None, 0)\n            ids.append(pid)\n        return ids\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p = self.particles[particle_id]\n        if p.status \"'!= '\"'active' or target_time < p.time:\n            raise InvalidActionError('bad forward')\n        steps = next(i for i,t in enumerate(self.time_grid) if t >= target_time - 1e-9) - next(i for i,t in enumerate(self.time_grid) if t >= p.time - 1e-9)\n        if self._nfe + steps > self.budget:\n            raise BudgetExceededError()\n        self._nfe += steps\n        status = 'completed' if abs(target_time - 1.0) < 1e-9 else 'active'\n        self.particles[particle_id] = ParticleSummary(p.id, target_time, p.parent_id, p.source_anchor_id, p.nfe_used + steps, status, p.last_preview_id, p.num_children)\n        return self.particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        if self._nfe + 1 > self.budget:\n            raise BudgetExceededError()\n        p = self.particles[particle_id]\n        self._nfe += 1\n        aid = self._next_aid\n        self._next_aid += 1\n        score = 0.5 + 0.1 * p.time - 0.01 * particle_id\n        rec = PreviewRecord(aid, particle_id, p.time, score, {}, max(0.0, 0.4 - 0.2 * p.time), 0.0, None)\n        self.previews[aid] = rec\n        self.particles[particle_id] = ParticleSummary(p.id, p.time, p.parent_id, p.source_anchor_id, p.nfe_used, p.status, aid, p.num_children)\n        return rec\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        parent_preview = self.previews[anchor_id]\n        out = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self.particles[pid] = ParticleSummary(pid, target_time, parent_preview.particle_id, anchor_id, 0, 'active', None, 0)\n            out.append(pid)\n        return out\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            p = self.particles[pid]\n            self.particles[pid] = ParticleSummary(p.id, p.time, p.parent_id, p.source_anchor_id, p.nfe_used, 'pruned', p.last_preview_id, p.num_children)\n    def answer(self, rule='best_preview_score'):\n        preview_id = max(self.previews, key=lambda aid: self.previews[aid].score) if self.previews else None\n        particle_id = self.previews[preview_id].particle_id if preview_id is not None else None\n        return AnswerRecord(particle_id, preview_id, (), None, self._nfe, rule, [])\n    def get_state(self):\n        return ControllerState('', self.budget_left, [pid for pid,p in self.particles.items() if p.status=='active'], [pid for pid,p in self.particles.items() if p.status=='completed'], [pid for pid,p in self.particles.items() if p.status=='pruned'], dict(self.particles), dict(self.previews), [])\n\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv()\n    ans = OptimalController().solve(env, beta)\n    print(beta, ans.nfe_used, ans.rule, ans.preview_id is not None)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
