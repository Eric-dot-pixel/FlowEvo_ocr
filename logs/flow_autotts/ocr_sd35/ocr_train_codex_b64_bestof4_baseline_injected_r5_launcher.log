reward=0.0, nfe_used=self._used, rule=rule, event_log=[], score_dict={})\n    def get_state(self):\n        return ControllerState(prompt='x', budget_left=self.budget_left, active_particle_ids=[pid for pid,p in self.particles.items() if p.status=='active'], completed_particle_ids=[pid for pid,p in self.particles.items() if p.status=='completed'], pruned_particle_ids=[pid for pid,p in self.particles.items() if p.status=='pruned'], particles={pid: ParticleSummary(id=pid, time=p.time, parent_id=None, source_anchor_id=None, nfe_used=0, status=p.status, last_preview_id=p.last_preview_id, num_children=0) for pid,p in self.particles.items()}, previews=dict(self.previews), event_log=[])\n\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv()\n    ans = OptimalController().solve(env, beta)\n    print(beta, ans.nfe_used, ans.rule, ans.reward)\nPY\"","aggregated_output":"0.0 7 best_preview_score 0.42\n0.25 20 best_preview_score 1.1\n0.5 34 best_preview_score 1.3\n0.75 35 best_preview_score 1.3\n1.0 48 best_preview_score 1.5\n","exit_code":0,"status":"completed"}}
