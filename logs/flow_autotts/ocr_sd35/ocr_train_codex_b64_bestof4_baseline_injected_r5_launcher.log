{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.state import ControllerState, ParticleSummary, PreviewRecord, AnswerRecord, EventRecord\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\n\nclass FakeEnv:\n    def __init__(self, budget=64):\n        self.time_grid = [0.0, 0.25, 0.5, 0.75, 1.0]\n        self.budget = budget\n        self.budget_left = budget\n        self._next_pid = 0\n        self._next_prid = 0\n        self.particles = {}\n        self.previews = {}\n        self.event_log = []\n    def spawn(self, n):\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self.particles[pid] = ParticleSummary(pid, 0.0, None, None, 0, 'active', None, 0)\n            ids.append(pid)\n        return ids\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p = self.particles[particle_id]\n        if p.status \"'!= '\"'active' or target_time <= p.time:\n            raise InvalidActionError('bad forward')\n        steps = sum(1 for t in self.time_grid if p.time < t <= target_time)\n        if self.budget_left < steps:\n            raise BudgetExceededError()\n        self.budget_left -= steps\n        status = 'completed' if target_time >= 1.0 else 'active'\n        self.particles[particle_id] = ParticleSummary(p.id, target_time, p.parent_id, p.source_anchor_id, p.nfe_used + steps, status, p.last_preview_id, p.num_children)\n        return self.particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self.particles[particle_id]\n        if self.budget_left < 1:\n            raise BudgetExceededError()\n        self.budget_left -= 1\n        prid = self._next_prid\n        self._next_prid += 1\n        score = p.time + particle_id * 0.01\n        prev = PreviewRecord(prid, particle_id, p.time, score, {}, 0.1 if p.time < 1.0 else 0.0, 0.0, None)\n        self.previews[prid] = prev\n        self.particles[particle_id] = ParticleSummary(p.id, p.time, p.parent_id, p.source_anchor_id, p.nfe_used + 1, p.status, prid, p.num_children)\n        return prev\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if anchor_id not in self.previews:\n            raise InvalidActionError('bad anchor')\n        parent = self.previews[anchor_id].particle_id\n        ids = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self.particles[pid] = ParticleSummary(pid, target_time, parent, anchor_id, 0, 'active', None, 0)\n            ids.append(pid)\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            if pid in self.particles:\n                p = self.particles[pid]\n                self.particles[pid] = ParticleSummary(p.id, p.time, p.parent_id, p.source_anchor_id, p.nfe_used, 'pruned', p.last_preview_id, p.num_children)\n    def answer(self, rule='best_preview_score'):\n        preview_id = None\n        particle_id = None\n        if self.previews:\n            best = max(self.previews.values(), key=lambda x: x.score if x.score is not None else -1e9)\n            preview_id = best.id\n            particle_id = best.particle_id\n        elif self.particles:\n            particle_id = next(iter(self.particles))\n        return AnswerRecord(particle_id, preview_id, tuple(), None, self.budget - self.budget_left, rule, list(self.event_log), {})\n    def get_state(self):\n        active = [pid for pid,p in self.particles.items() if p.status == 'active']\n        completed = [pid for pid,p in self.particles.items() if p.status == 'completed']\n        pruned = [pid for pid,p in self.particles.items() if p.status == 'pruned']\n        return ControllerState('', self.budget_left, active, completed, pruned, dict(self.particles), dict(self.previews), list(self.event_log))\n\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv()\n    ans = OptimalController().solve(env, beta)\n    print(beta, ans.rule, ans.nfe_used, env.budget_left)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
