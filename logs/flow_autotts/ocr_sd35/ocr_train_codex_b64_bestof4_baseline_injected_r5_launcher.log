{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.env import FlowTTSEnv\n\n\nclass ToyModel:\n    def velocity(self, z, t, prompt):\n        target = 1.2 if 'good' in prompt else 0.8\n        return tuple(target - x for x in z)\n\n\nclass ToyScorer:\n    def score(self, decoded, prompt):\n        val = sum(decoded) / len(decoded)\n        reward = max(0.0, 1.0 - abs(val - 1.0))\n        return reward, {'toy': reward}\n\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FlowTTSEnv(\n        model=ToyModel(),\n        vae=None,\n        scorer=ToyScorer(),\n        prompt='good prompt',\n        budget=64,\n        time_grid=[i / 10 for i in range(11)],\n        seed=123,\n        latent_shape=(4,),\n    )\n    ans = controller.solve(env, beta)\n    print(beta, ans.nfe_used, ans.rule, ans.reward, len(ans.event_log))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom dataclasses import dataclass\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.env import FlowTTSEnv\n\n\nclass ToyModel:\n    def velocity(self, z, t, prompt):\n        target = 1.2 if 'good' in prompt else 0.8\n        return tuple(target - x for x in z)\n\n\nclass ToyScorer:\n    def score(self, decoded, prompt):\n        val = sum(decoded) / len(decoded)\n        reward = max(0.0, 1.0 - abs(val - 1.0))\n        return reward, {'toy': reward}\n\n\ncontroller = OptimalController()\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FlowTTSEnv(\n        model=ToyModel(),\n        vae=None,\n        scorer=ToyScorer(),\n        prompt='good prompt',\n        budget=64,\n        time_grid=[i / 10 for i in range(11)],\n        seed=123,\n        latent_shape=(4,),\n    )\n    ans = controller.solve(env, beta)\n    print(beta, ans.nfe_used, ans.rule, ans.reward, len(ans.event_log))\nPY\"","aggregated_output":"0.0 4 best_preview_score 0.936384185544358 6\n0.25 12 best_preview_score 0.9254001932753729 18\n0.5 24 best_preview_score 0.9500890265413573 36\n0.75 37 best_preview_score 0.936384185544358 53\n1.0 53 best_preview_score 0.9471341286845533 75\n","exit_code":0,"status":"completed"}}
