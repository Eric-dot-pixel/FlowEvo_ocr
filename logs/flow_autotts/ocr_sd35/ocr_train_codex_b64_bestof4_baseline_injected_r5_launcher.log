prev = PreviewRecord(prid, particle_id, p.time, score, {}, 0.1 if p.time < 1.0 else 0.0, 0.0, None)\n        self.previews[prid] = prev\n        self.particles[particle_id] = ParticleSummary(p.id, p.time, p.parent_id, p.source_anchor_id, p.nfe_used + 1, p.status, prid, p.num_children)\n        return prev\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if anchor_id not in self.previews:\n            raise InvalidActionError('bad anchor')\n        parent = self.previews[anchor_id].particle_id\n        ids = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self.particles[pid] = ParticleSummary(pid, target_time, parent, anchor_id, 0, 'active', None, 0)\n            ids.append(pid)\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            if pid in self.particles:\n                p = self.particles[pid]\n                self.particles[pid] = ParticleSummary(p.id, p.time, p.parent_id, p.source_anchor_id, p.nfe_used, 'pruned', p.last_preview_id, p.num_children)\n    def answer(self, rule='best_preview_score'):\n        preview_id = None\n        particle_id = None\n        if self.previews:\n            best = max(self.previews.values(), key=lambda x: x.score if x.score is not None else -1e9)\n            preview_id = best.id\n            particle_id = best.particle_id\n        elif self.particles:\n            particle_id = next(iter(self.particles))\n        return AnswerRecord(particle_id, preview_id, tuple(), None, self.budget - self.budget_left, rule, list(self.event_log), {})\n    def get_state(self):\n        active = [pid for pid,p in self.particles.items() if p.status == 'active']\n        completed = [pid for pid,p in self.particles.items() if p.status == 'completed']\n        pruned = [pid for pid,p in self.particles.items() if p.status == 'pruned']\n        return ControllerState('', self.budget_left, active, completed, pruned, dict(self.particles), dict(self.previews), list(self.event_log))\n\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv()\n    ans = OptimalController().solve(env, beta)\n    print(beta, ans.nfe_used)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom flow_autotts.controllers.optimal import OptimalController\nfrom flow_autotts.core.state import ControllerState, ParticleSummary, PreviewRecord, AnswerRecord\nfrom flow_autotts.core.errors import BudgetExceededError, InvalidActionError\n\nclass FakeEnv:\n    def __init__(self, budget=64):\n        self.time_grid = [0.0, 0.25, 0.5, 0.75, 1.0]\n        self.budget = budget\n        self.budget_left = budget\n        self._next_pid = 0\n        self._next_prid = 0\n        self.particles = {}\n        self.previews = {}\n        self.event_log = []\n    def spawn(self, n):\n        ids = []\n        for _ in range(n):\n            pid = self._next_pid\n            self._next_pid += 1\n            self.particles[pid] = ParticleSummary(pid, 0.0, None, None, 0, 'active', None, 0)\n            ids.append(pid)\n        return ids\n    def forward(self, particle_id, target_time, solver='euler', cfg=None):\n        p = self.particles[particle_id]\n        if p.status \"'!= '\"'active' or target_time <= p.time:\n            raise InvalidActionError('bad forward')\n        steps = sum(1 for t in self.time_grid if p.time < t <= target_time)\n        if self.budget_left < steps:\n            raise BudgetExceededError()\n        self.budget_left -= steps\n        status = 'completed' if target_time >= 1.0 else 'active'\n        self.particles[particle_id] = ParticleSummary(p.id, target_time, p.parent_id, p.source_anchor_id, p.nfe_used + steps, status, p.last_preview_id, p.num_children)\n        return self.particles[particle_id]\n    def preview(self, particle_id, mode='clean_anchor', scorer='default'):\n        p = self.particles[particle_id]\n        if self.budget_left < 1:\n            raise BudgetExceededError()\n        self.budget_left -= 1\n        prid = self._next_prid\n        self._next_prid += 1\n        score = p.time + particle_id * 0.01\n        prev = PreviewRecord(prid, particle_id, p.time, score, {}, 0.1 if p.time < 1.0 else 0.0, 0.0, None)\n        self.previews[prid] = prev\n        self.particles[particle_id] = ParticleSummary(p.id, p.time, p.parent_id, p.source_anchor_id, p.nfe_used + 1, p.status, prid, p.num_children)\n        return prev\n    def backward(self, anchor_id, target_time, noise_policy='fresh_noise', num_children=1, mask=None, strength=1.0):\n        if anchor_id not in self.previews:\n            raise InvalidActionError('bad anchor')\n        parent = self.previews[anchor_id].particle_id\n        ids = []\n        for _ in range(num_children):\n            pid = self._next_pid\n            self._next_pid += 1\n            self.particles[pid] = ParticleSummary(pid, target_time, parent, anchor_id, 0, 'active', None, 0)\n            ids.append(pid)\n        return ids\n    def prune(self, particle_ids):\n        for pid in particle_ids:\n            if pid in self.particles:\n                p = self.particles[pid]\n                self.particles[pid] = ParticleSummary(p.id, p.time, p.parent_id, p.source_anchor_id, p.nfe_used, 'pruned', p.last_preview_id, p.num_children)\n    def answer(self, rule='best_preview_score'):\n        preview_id = None\n        particle_id = None\n        if self.previews:\n            best = max(self.previews.values(), key=lambda x: x.score if x.score is not None else -1e9)\n            preview_id = best.id\n            particle_id = best.particle_id\n        elif self.particles:\n            particle_id = next(iter(self.particles))\n        return AnswerRecord(particle_id, preview_id, tuple(), None, self.budget - self.budget_left, rule, list(self.event_log), {})\n    def get_state(self):\n        active = [pid for pid,p in self.particles.items() if p.status == 'active']\n        completed = [pid for pid,p in self.particles.items() if p.status == 'completed']\n        pruned = [pid for pid,p in self.particles.items() if p.status == 'pruned']\n        return ControllerState('', self.budget_left, active, completed, pruned, dict(self.particles), dict(self.previews), list(self.event_log))\n\nfor beta in [0.0, 0.25, 0.5, 0.75, 1.0]:\n    env = FakeEnv()\n    ans = OptimalController().solve(env, beta)\n    print(beta, ans.nfe_used)\nPY\"","aggregated_output":"0.0 10\n0.25 20\n0.5 36\n0.75 46\n1.0 63\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_24","type":"agent_message","text":"Implemented a new `OptimalController` in [flow_autotts/controllers/optimal.py](/inspire/hdd/global_user/gongjingjing-25039/sywang/jkcai/FlowEvo_ocr/flow_autotts/controllers/optimal.py). The idea is a beta-scheduled scout -> prune -> finish -> confirm -> adaptive backward refine policy, with one new mechanism that was not in the recent best snapshot: child allocation now depends on preview score gaps and uncertainty, and the tail-budget pass prefers late confirmation first, then spends remaining target NFE on fully evaluated local children from the current best anchor.\n\nI inspected the spec, the injected context pack, the current `optimal.py`, `baselines.py`, and the incumbent snapshot from `r0000`. From the compact frontier rows: `beta=0.0` had reward `0.358123` at `7` NFE, `0.25` had `0.591981` at `22`, `0.5` had `0.701755` at `35`, `0.75` had `0.776531` at `47`, and `1.0` had `0.807150` at `61`. Relative to the beta-matched ODE baseline, the incumbent was already above baseline at `0.0`, `0.25`, and `0.75`, but slightly below at `0.5` and `1.0`. The last rejected proposals made real behavioral changes, but the compact lessons showed the same failure mode: more branching/preview churn while still underspending target NFE. This round targets that weakness directly.\n\nThe exact beta schedule is monotone by construction: target NFE is `10, 20, 36, 48, 64` for betas `0, 0.25, 0.5, 0.75, 1.0`. Width also scales monotonically: roots `2, 2, 3, 4, 4`; survivors/confirm count increase with beta; backward child budget increases with beta; pruning gets gentler with beta; high beta alone enables bounded SDE scouting and mixed-noise refinement. `beta=1.0` cannot exceed `64` because every action is gated by `target_nfe <= min(env.budget, 64)` and all forward/preview/refinement actions check affordability before execution.\n\nUnderuse reflection against the injected targets:\n- `beta=0.0`, target `10`: earlier incumbent underused at `7`, but that was justified only by reward, not comparability. I adjusted this upward with two scouts and one tail confirmation so it should stay near `10` without adding backward noise.\n- `beta=0.25`, target `20`: incumbent already beat baseline at `22`; I adjusted the schedule to aim closer to `20` with limited refinement and one late-use pass.\n- `beta=0.5`, target `36`: this was the clearest weak regime below baseline at `35`. I adjusted it to spend the missing compute on late confirmation plus selective backward children instead of extra early churn.\n- `beta=0.75`, target `48`: incumbent was good at `47`; I kept the same overall style but made pruning gentler and added tail utilization, expecting it to stay close to target without collapsing diversity.\n- `beta=1.0`, target `64`: incumbent trailed baseline at `61`; I adjusted it to use more confirmation/refinement and a tail fill loop, while the affordability gates keep it below or at `64`.\n\nChecks run: `python -m py_compile flow_autotts/controllers/optimal.py` and a small fake-env dry run over betas `0, 0.25, 0.5, 0.75, 1.0`. In that dry run, realized NFE was `10, 20, 36, 46, 63`, which is close to the target curve and confirms termination and budget gating. Main risk: if the real env’s preview uncertainty is noisy or sparse, the gap/uncertainty child allocator may still overcommit to the current best anchor at high beta. The proposal is mainly meant to improve the weak `beta=0.5` and `beta=1.0` regions while protecting the already-strong `0.25` and `0.75` regimes."}}
